# Настройки сервиса. Скопируйте в .env и заполните. .env в git не попадает.

# Ключ ИИ — нужен для сборки по описанию и картинке, а также для npm run image-eval / gen-eval.
ANTHROPIC_API_KEY=

# Пароль страницы мониторинга затрат /admin. Пусто — мониторинг выключен.
ADMIN_TOKEN=

# Порт и база (SQLite: отчёты по ссылкам и журнал генераций).
PORT=8139
DB_PATH=var/stand.db
# Соль для хэша адресов в журнале (адреса в открытом виде не хранятся). Задайте свою случайную строку.
IP_SALT=

# Лимиты генерации через ИИ.
GEN_LIMIT_PER_HOUR=30
GEN_LIMIT_PER_USER_HOUR=10
GEN_LIMIT_PER_USER_DAY=40
GEN_BUDGET_USD_PER_DAY=10
REPORTS_PER_IP_HOUR=60

# 1 — сервис за обратным прокси (nginx, балансировщик): адрес клиента брать из X-Forwarded-For.
TRUST_PROXY=0
